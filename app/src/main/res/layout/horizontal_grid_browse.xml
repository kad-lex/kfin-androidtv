<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <org.jellyfin.androidtv.ui.shared.EdgeFadeFrameLayout
        android:id="@+id/rowsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/infoRow"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="28dp"
        android:layout_marginTop="22.5sp"
        android:layout_marginEnd="10sp"
        android:layout_toStartOf="@+id/npBug"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:maxLines="1"
        android:textSize="32sp" 
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
    />

    <TextView
        android:id="@+id/overview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/infoRow"
        android:layout_alignStart="@+id/title"
        android:layout_toStartOf="@+id/toolBar"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="3"
        android:textSize="13sp" 
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
    />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="20sp"
        android:layout_below="@+id/title"
        android:layout_alignStart="@+id/title"
        android:layout_marginTop="5sp"
        android:id="@+id/infoRow"
        android:layout_toStartOf="@+id/clock"/>

    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:alpha=".75"
        android:dividerPadding="4dp"
        android:gravity="bottom|end"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0 | 0"
        android:id="@+id/counter"
        android:visibility="gone"
        android:textAlignment="viewEnd"
        android:textSize="18sp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/statusText"
        android:textSize="12sp"
        android:alpha=".6"
        android:layout_alignStart="@+id/title"
        android:layout_alignTop="@+id/counter"
        android:layout_marginTop="6sp"
        android:fontFamily="sans-serif-light" />

    <org.jellyfin.androidtv.ui.ClockUserView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/clock"
        android:layout_alignTop="@+id/title"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="8sp"
        android:layout_alignParentEnd="true" />

    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/itemLogo"
        android:layout_width="wrap_content"
        android:layout_height="86dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="28dp"
        android:maxWidth="320dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <View
        android:id="@+id/menuAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="24dp" />

    <org.jellyfin.androidtv.ui.NowPlayingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/npBug"
        android:layout_toStartOf="@+id/clock"
        android:layout_alignTop="@+id/clock"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
